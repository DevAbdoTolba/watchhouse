# BitVision / Cantonk DVR
DVR_IP=192.168.1.10
DVR_PORT=554
DVR_USER=admin
DVR_PASS=changeme

# Optional: which stream each tile starts on (sub or main). Default: sub.
CAM1_DEFAULT=sub
CAM2_DEFAULT=sub
CAM3_DEFAULT=sub
CAM4_DEFAULT=sub

# --- Recorder (v0.2.0) ---
# Set RECORDING_ENABLED=0 to disable the local recorder entirely.
RECORDING_ENABLED=1
# Default is <env_dir>/recordings; set an absolute path here to override.
# RECORDING_DIR=D:\Watchhouse\recordings
# Which stream to record. sub = ~100 KB/s/cam (recommended); main = full quality, much heavier.
RECORDING_STREAM=sub
# Segment length in minutes. Each segment is a self-contained MP4. A segment
# can only be read/cut AFTER it closes (the MP4 index is written on close), so
# this also bounds how fast the 4-cam evidence event and the "other angles"
# reply become available. Default 3 = worst-case ~3 min, not 15. The instant
# photo + quick clip (live tier) are unaffected and stay immediate.
RECORDING_SEGMENT_MINUTES=3
# Auto-delete segments older than this many days.
RECORDING_RETENTION_DAYS=7

# --- Telegram push notifications (optional) ---
# Create a bot with @BotFather to get the token; add the bot to your family
# group, then read the chat id from getUpdates. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Minimum seconds between alerts per camera (anti-spam). Default 20.
TELEGRAM_MIN_INTERVAL_SECONDS=20
# Interactive reply commands: reply to an alert photo -> that camera's clip;
# reply to a clip -> the other camera angles; /help, /last. 1=on, 0=off.
TELEGRAM_COMMANDS=1
# Replied videos are the REAL event clip, capped at this many seconds: a short
# event is sent at its true (dynamic) length; a long presence chunk is trimmed
# to a tight excerpt. The full-length clip always stays in the gallery.
# (Currently a fixed 30s cap in code; this key is reserved for making it tunable.)
TELEGRAM_CLIP_MAX_SECONDS=30
# Language of the messages the bot sends to the family: en | ar. Also selectable
# in the GUI (System menu -> Telegram Alerts… -> Language).
TELEGRAM_LANG=en
# How many recent sent messages stay replyable (the message->event memory).
# ~5000 = months of history at a typical alert rate; the file stays tiny.
TELEGRAM_MAP_CAP=5000

# --- DVR clock offset (v0.4.64) ---
# The DVR often ignores daylight-saving, so its burned-in time runs behind the
# PC. This shifts every time the app SHOWS (Telegram captions, events list,
# timeline axis, clocks) to match the DVR. Pure display: recordings/lookups stay
# on PC time. Minutes; negative = DVR is behind. Example: DVR 1 h behind -> -60.
DVR_TIME_OFFSET_MINUTES=0

# --- Detection false-positive guards (v0.4.63 / per-camera v0.4.69) ---
# yolov8n on a grainy night sub-stream sometimes calls rubbish a "person".
# Two cheap filters (apply to BOTH the live and segment tiers):
#   PERSON_CONF  - GLOBAL extra confidence floor for the 'person' class. Default 0
#                  (off): a global floor drops faint-but-real people on quiet
#                  cameras, so the per-camera floors below are preferred instead.
DETECTION_PERSON_CONF=0
#   PERSON_CONF_BY_CAM - the recommended, per-camera floor. Cap ONLY a noisy view
#                  (e.g. a door cam that reads bin bags as a person up to ~0.76,
#                  while real people there hit 0.80+); leave quiet cameras uncapped
#                  so a faint real person is never dropped. "cam:floor" pairs.
#                  Example: cam4 bags -> 4:0.78  (multiple: "4:0.78,2:0.6").
#                  Editable live in-app: System ▸ Detection Confidence…
#                  (UI edits persist to .cctv-detection.json and override this).
DETECTION_PERSON_CONF_BY_CAM=
#   MIN_BOX_FRAC - drop any detection whose box is smaller than this fraction of
#                  the frame's larger side (kills tiny specks). 0 disables.
#                  Lower it if a genuinely distant/small subject must still fire.
DETECTION_MIN_BOX_FRAC=0.07

# --- Real-time alert tier (v0.4.35) ---
# Instant person/vehicle alert off the LIVE preview frames (seconds, not the
# segment delay). Only the armed cameras (DETECTION_CAMERAS) are watched.
# Confidence for the instant alert (a bit higher than batch to cut false pings).
LIVE_CONF=0.40
# Min seconds between live alerts per camera, so a lingering subject = one ping.
LIVE_COOLDOWN_SECONDS=45
# Instant quick-clip (v0.4.53 = DYNAMIC): a fast in-memory clip whose length
# MATCHES the movement, fetched by replying to the alert photo. The live brain
# already watches every frame, so the clip stays open while movement continues
# and closes shortly after it stops - a 3s movement = ~3s clip, a long stand is
# capped (see below). Saved under recordings/live_clips/ (NOT the gallery).
# 1=on, 0=off. The instant PHOTO is unaffected and always fires.
LIVE_QUICK_CLIP=1
# Pre-roll = lead-in kept BEFORE movement. Post-roll = grace kept AFTER movement
# stops (how long with no detection before the clip closes). Max = hard ceiling
# so a long presence is one capped clip, not endless. ~2 + movement + 7, ≤ 30s.
# Post-roll also absorbs brief pauses / detector flicker mid-movement, so the
# clip doesn't cut off while the person is still there. Raise if it still crops.
LIVE_PRE_ROLL_SECONDS=2
LIVE_POST_ROLL_SECONDS=7
LIVE_MAX_CLIP_SECONDS=30
# Auto-push the quick clip to Telegram the moment it's ready (no reply needed).
LIVE_AUTOSEND_CLIP=1
